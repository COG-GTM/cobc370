#!/usr/bin/env bash
# tk5-start: IPL a TK5 (MVS 3.8j) guest under Hercules, unattended, and wait until it accepts jobs.
# Env: TK5_HOME         TK5 install directory            (default ~/mvs-demo/mvs-tk5)
#      HERCULES         Hercules binary                  (default ~/mvs-demo/hercules-install/bin/hercules, else PATH)
#      TK5_CONSOLE_LOG  Hercules console log             (default $TK5_HOME/log/hercules-console.log)
#      MVS_NAMESPACE    optional Linux network namespace that keeps the guest's ports off the host (needs sudo -n)
#      TK5_EXPOSE=1     keep TK5's own defaults (console 3270, card reader 3505 and web console 8038 on all interfaces).
#                       Default: console and card reader bound to 127.0.0.1 and the Hercules web console stopped at IPL.
set -euo pipefail
tk5=${TK5_HOME:-$HOME/mvs-demo/mvs-tk5}
herc=${HERCULES:-$HOME/mvs-demo/hercules-install/bin/hercules}
[ -x "$herc" ] || herc=$(command -v hercules) || { echo "tk5-start: Hercules not found; set HERCULES" >&2; exit 1; }
[ -f "$tk5/conf/tk5.cnf" ] || { echo "tk5-start: no TK5 at $tk5; set TK5_HOME (see docs/TK5-SETUP.md)" >&2; exit 1; }
log=${TK5_CONSOLE_LOG:-$tk5/log/hercules-console.log}
pidf=$tk5/log/hercules.pid   # "<pid> <process start time> <console log line at launch>"
mkdir -p "$tk5/log" "$(dirname "$log")"
starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
# Ours only if the PID is alive and still has the start time recorded at launch (guards against PID reuse).
ours() { read -r p st _ <"$pidf" 2>/dev/null && [ -n "${st:-}" ] && [ "$(starttime "$p")" = "$st" ]; }
stop_guest() { read -r p _ <"$pidf"; kill "$p" 2>/dev/null || true
  for _ in $(seq 1 30); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
  ! ours || kill -9 "$p" 2>/dev/null || true; rm -f "$pidf"; }
wait_ready() {
  read -r p _ m <"$pidf"
  for _ in $(seq 1 300); do
    if tail -n +"$((m + 1))" "$log" | grep -q "MVS038J.*system initialization complete"; then
      echo "tk5-start: MVS 3.8j ready (pid $p, console log $log)"; exit 0
    fi
    ours || { rm -f "$pidf"; echo "tk5-start: Hercules exited; see $log" >&2; exit 1; }
    sleep 1
  done
  stop_guest; echo "tk5-start: timed out waiting for IPL; guest stopped; see $log" >&2; exit 1
}
if [ -s "$pidf" ]; then
  ours && wait_ready
  echo "tk5-start: removing stale $pidf"; rm -f "$pidf"
fi
touch "$log"; mark=$(wc -l <"$log")
cd "$tk5"
envs=(HERCULES_RC=scripts/ipl.rc)
if [ "${TK5_EXPOSE:-0}" != 1 ]; then
  rc=$tk5/log/ashgrove-ipl.rc
  { echo "http stop"; cat scripts/ipl.rc; } >"$rc"
  envs=(HERCULES_RC="$rc" CNSLPORT="${CNSLPORT:-127.0.0.1:3270}" RDRPORT="${RDRPORT:-127.0.0.1:3505}")
fi
cmd=(env "${envs[@]}" TK5CONS=intcons REP101A=specific CMD101A=02 "$herc" -d -f conf/tk5.cnf)
if [ -n "${MVS_NAMESPACE:-}" ]; then
  sudo -n ip netns list | awk '{print $1}' | grep -qx "$MVS_NAMESPACE" || sudo -n ip netns add "$MVS_NAMESPACE"
  sudo -n ip netns exec "$MVS_NAMESPACE" ip link set lo up
  cmd=(sudo -n ip netns exec "$MVS_NAMESPACE" runuser -u "$(id -un)" -- "${cmd[@]}")
fi
nohup "${cmd[@]}" </dev/null >>"$log" 2>&1 &
pid=$!
echo "$pid $(starttime "$pid") $mark" >"$pidf"
wait_ready
