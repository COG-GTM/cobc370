         MACRO
&LBL     ASHRLEN &REG,&DCB
.*  ASHGROVE MUTUAL SHOP MACRO LIBRARY      SYSTEMS PROGRAMMING 1987
.*  LOAD RECORD LENGTH FROM AN OPEN DCB.    USED BY POLICY I/O ROUTINES
.*  PROPOSED (NOT APPLIED): DCBLRECL IS AT X'52' IN IHADCB (DCBD MACRO,
.*  SYS1.MACLIB).  X'3E' (62) IS DCBBLKSI, THE BLOCK SIZE.
&LBL     LH    &REG,82(,&DCB)          DCBLRECL
         MEND
